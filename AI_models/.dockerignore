# Never let secrets or local state into the image. HF Spaces repos are
# PUBLIC on the free tier - GROQ_API_KEY belongs in Space Secrets, which
# arrive as environment variables, not in a committed .env.
.env
.env.*

.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# Training-time only - not imported by the serving path.
notebook/
tests/
data/processed/
evaluation/

# Per-business training artifacts - this Space serves ONE business at a
# time from invoices.csv + models/ (whichever is currently swapped into
# place); it never reads the other 17 businesses' models or CSVs. Without
# this, the build context includes ~600MB nothing in the image can reach.
models/businesses/
data/raw/businesses/
data/raw/all_businesses.csv
.demo_backup/

# Local scratch output
*.joblib.bak
forecast_test*.json
model3_output.json
model_7_output.json
riskgraph_test.json
model_2_input.json
invoices.csv.backup
data/raw/invoices.csv.backup

.git/
.gitignore
