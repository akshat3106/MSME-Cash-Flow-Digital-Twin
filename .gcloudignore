# Controls what gets uploaded to Cloud Build as source (separate from
# .dockerignore, which controls what the Docker build itself sees once
# uploaded). Without this, `gcloud builds submit` falls back to the root
# .gitignore, which does not know about AI_models/.venv/ (735MB, nested
# .gitignore not consulted) - that alone makes the difference between a
# ~60MB upload and a multi-hundred-MB one.
.git/
.gcloudignore
.claude/

frontend/node_modules/
frontend/dist/
backend/node_modules/
AI_models/.venv/
AI_models/__pycache__/

AI_models/notebook/
AI_models/tests/
AI_models/data/processed/
AI_models/evaluation/

# Per-business training artifacts (train_model1.py --all-businesses /
# generate_invoices.py). Cloud Run serves ONE business at a time from
# AI_models/invoices.csv + AI_models/models/ (whichever is currently
# swapped into place) - it never reads models/businesses/ or the other 17
# businesses' CSVs. Without this, `gcloud builds submit` uploads ~600MB of
# files the deployed service can never reach.
AI_models/models/businesses/
AI_models/data/raw/businesses/
AI_models/data/raw/all_businesses.csv
AI_models/.demo_backup/
