# The backend gateway (see backend/README.md for how to run it).
VITE_API_BASE_URL=http://localhost:9000

# Firebase Web App config for CashTwin authentication. Get these from your
# own Firebase project: console.firebase.google.com > Project settings >
# General > Your apps > Web app > SDK setup and configuration > Config.
# These are client-exposed by design (Firebase restricts access via Security
# Rules / authorized domains, not by hiding this config) but each deployment
# should still point at its own project, not share one across forks.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
